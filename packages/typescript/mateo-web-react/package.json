{
  "name": "@mateo/web-react",
  "version": "0.0.0",
  "private": true,
  "description": "The React implementation of Mateo for desktop-first, responsive websites and web apps.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ventairy/mateo.git",
    "directory": "packages/typescript/mateo-web-react"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^24.15.0"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "types": "./dist/mateo.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mateo.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/mateo-react.d.ts",
      "import": "./dist/react.js"
    },
    "./icons": {
      "types": "./dist/mateo-icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./fonts/inter-latin.woff2": "./dist/inter-latin.woff2",
    "./fonts/inter-variable.woff2": "./dist/inter-variable.woff2",
    "./fonts/inter-italic-latin.woff2": "./dist/inter-italic-latin.woff2",
    "./fonts/inter-italic.woff2": "./dist/inter-italic.woff2",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "node scripts/generate-mateo-icons.mjs && vite build && tsc -p tsconfig.build.json && node scripts/check-mateo-build.mjs && node scripts/check-mateo-icon-delivery.mjs",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint . --error-on-warnings",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "check": "biome ci . --error-on-warnings && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:golden:run && pnpm run test:browser:run",
    "fix": "biome check --write .",
    "test:golden": "pnpm run build && pnpm run test:golden:run",
    "test:golden:run": "vitest run --project golden",
    "test:golden:update": "pnpm run build && vitest run --project golden --update",
    "test:browser:run": "vitest run --project browser"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/types": "7.29.8",
    "@mateo/icons": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/culori": "4.0.1",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.3",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.0.3",
    "vitest-browser-react": "2.3.0"
  },
  "dependencies": {
    "culori": "4.0.2"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
